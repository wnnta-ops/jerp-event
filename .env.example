# ───────────────────────────────────────────────────────────────────
# PRODUKSI (VPS): minimal ubah baris berikut, lalu `docker compose up -d --build`
#   APP_ENV=production   APP_DEBUG=false   APP_URL=https://domain-anda
#   DB_PASSWORD=<kuat>   MYSQL_ROOT_PASSWORD=<kuat>
#   REVERB_SCHEME=https  VITE_REVERB_HOST=domain-anda  HTTP_PORT=8080
#   REVERB_APP_KEY/SECRET=<acak>   MEILISEARCH_KEY=<acak>
# APP_KEY biarkan KOSONG — entrypoint auto-generate sekali saat boot pertama.
# (Dev cukup biarkan nilai default di bawah.)
# ───────────────────────────────────────────────────────────────────
APP_NAME="J-ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Compose port overrides (host-side) ──────────────────────────────
HTTP_PORT=8081
MYSQL_PORT=3306
REDIS_PORT=6379
MEILI_PORT=7700
REVERB_PORT=8088

# ── Database (containers reach mysql via service name) ──────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jerp
DB_USERNAME=jerp
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# ── Redis ────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=jerp

# ── Cache / Session / Queue ─────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# ── Broadcast (Reverb) ──────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=jerp
REVERB_APP_KEY=jerpkey
REVERB_APP_SECRET=jerpsecret
REVERB_HOST=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8088
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Browser-side WS host — harus reachable dari mesin user (bukan hostname docker).
# Dev: 'localhost'. Prod: domain publik yang di-proxy WSS.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Subdomain publik (opsional) ─────────────────────────────────────
# Kosongkan untuk lokal/dev (akses via path: /nup/daftar, /siteplan).
# Isi HANYA di server bila ingin subdomain sendiri, mis:
#   NUP_DOMAIN=daftar.domainanda.com
#   SITEPLAN_DOMAIN=siteplan.domainanda.com
# Root "/" subdomain itu akan langsung menyajikan halaman terkait.
NUP_DOMAIN=
SITEPLAN_DOMAIN=

# ── Search (Meilisearch) ────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILI_ENV=development

# ── Filesystem ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jerp.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / S3 (opsional, prod) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── 3rd-party integrations (Phase 3+) ───────────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Backup — root folder default disk lokal "backup_target" (bisa diubah di UI Pengaturan Backup)
BACKUP_TARGET_ROOT=

# Mekari Qontak — WhatsApp notification (UTJ payment & NUP confirmation)
QONTAK_ACCESS_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
QONTAK_BASE_URL=https://service-chat.qontak.com/api/open/v1
QONTAK_LANGUAGE=id
QONTAK_TEMPLATE_UTJ=
QONTAK_TEMPLATE_KONFIRMASI=

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
VITE_RECAPTCHA_SITE_KEY="${RECAPTCHA_SITE_KEY}"

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=

# ── Backup ──────────────────────────────────────────────────────────
BACKUP_DESTINATION_DISKS=local
BACKUP_NOTIFICATION_EMAIL=
BACKUP_RETENTION_DAYS=365

# ── Error tracking (opsional) ───────────────────────────────────────
SENTRY_LARAVEL_DSN=

# ── Vite ────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
