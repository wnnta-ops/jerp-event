# ───────────────────────────────────────────────────────────────────
# J-ERP (FRONT OFFICE). BO/Bankloan = ipro-fo (lihat marger/ipro-fo_1/ipro-fo/.env).
#
# PRODUKSI / SERVER TEST (domain): minimal ubah baris berikut, lalu deploy
#   (lihat marger/DEPLOY.md & marger/CATATAN-SERVER.md):
#   APP_ENV=production   APP_DEBUG=false
#   APP_URL=https://fo.test.com            ← domain FO
#   DB_PASSWORD=<kuat>   MYSQL_ROOT_PASSWORD=<kuat>
#   REVERB_SCHEME=https  VITE_REVERB_HOST=fo.test.com
#   REVERB_APP_KEY/SECRET=<acak>   MEILISEARCH_KEY=<acak>
#   + WAJIB isi blok "INTEGRASI BO" di bawah (SSO_SHARED_SECRET, IPRO_APP_KEY, IPRO_BO_URL).
# APP_KEY biarkan KOSONG — entrypoint auto-generate sekali saat boot pertama.
# (Dev cukup biarkan nilai default di bawah.)
# ───────────────────────────────────────────────────────────────────
APP_NAME="Java Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Domain FO. Server: https://fo.test.com  ·  Lokal: http://localhost:8081
APP_URL=http://localhost:8081
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Compose port overrides (host-side) ──────────────────────────────
HTTP_PORT=8081
MYSQL_PORT=3306
REDIS_PORT=6379
MEILI_PORT=7700
REVERB_PORT=8088

# ── Database (containers reach mysql via service name) ──────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jerp
DB_USERNAME=jerp
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# ── Redis ────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=jerp

# ── Cache / Session / Queue ─────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# ── Broadcast (Reverb) ──────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=jerp
REVERB_APP_KEY=jerpkey
REVERB_APP_SECRET=jerpsecret
REVERB_HOST=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8088
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Browser-side WS host — harus reachable dari mesin user (bukan hostname docker).
# Dev: 'localhost'. Prod: domain publik yang di-proxy WSS.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Subdomain publik FO (opsional) ──────────────────────────────────
# Halaman publik (pendaftaran NUP, siteplan, booked) bisa diberi subdomain sendiri.
# Kosongkan untuk lokal/dev (akses via path: /nup/daftar, /siteplan, /booked).
# Isi HANYA di server bila ingin subdomain — root "/" subdomain langsung buka halaman:
#   NUP_DOMAIN=daftar.test.com
#   SITEPLAN_DOMAIN=siteplan.test.com
#   BOOKED_DOMAIN=booked.test.com
NUP_DOMAIN=
SITEPLAN_DOMAIN=
BOOKED_DOMAIN=

# ═══════════════════════════════════════════════════════════════════
# INTEGRASI BO (ipro-fo) — SSO, sync FO→BO, posting GL (database ipro_bo)
# Detail: marger/DEPLOY.md & marger/CATATAN-SERVER.md.
# ═══════════════════════════════════════════════════════════════════
# (1) WAJIB SAMA dgn ipro-fo — kunci tanda tangan SSO (HMAC). Generate sekali:
#     php -r "echo bin2hex(random_bytes(32));"   lalu tempel di SINI & di .env ipro-fo.
SSO_SHARED_SECRET=
# (2) WAJIB = APP_KEY ipro-fo (salin apa adanya dari .env ipro-fo, termasuk "base64:").
#     JANGAN `php artisan key:generate` di ipro-fo. Dipakai enkripsi NIK/NPWP.
IPRO_APP_KEY=
# (3) URL BO (ipro-fo) tujuan SSO.  Server: https://bo.test.com  ·  Lokal: http://localhost:8090
IPRO_BO_URL=http://localhost:8090

# Koneksi DB BO (ipro_bo). KOSONGKAN = pakai MySQL yang SAMA dgn FO (DB_* di atas, 1 server).
# Isi HANYA jika ipro_bo berada di server MySQL lain.
IPRO_DB_HOST=
IPRO_DB_PORT=
IPRO_DB_DATABASE=ipro_bo
IPRO_DB_USERNAME=
IPRO_DB_PASSWORD=

# Tenant & project default ipro_bo (umumnya 1).
IPRO_TENANT_ID=1
IPRO_PROJECT_ID=1

# Sinkronisasi & GL.
IPRO_SYNC_ENABLED=true
IPRO_GL_ENABLED=true
IPRO_GL_STATUS=draft               # draft → akuntan verifikasi mapping COA sebelum 'posted'
IPRO_CIPHER=AES-256-CBC            # ikut ipro-fo; jangan ubah kecuali ipro-fo berubah
IPRO_SUSPENSE_ACCOUNT_ID=0         # bs_accounts.id penampung saat COA tak terpetakan (0=gagal→outbox)

# Approval — izinkan setujui permohonan sendiri (langgar separation of duties). Biarkan false.
APPROVAL_ALLOW_SELF=false

# ── Search (Meilisearch) ────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey
MEILI_ENV=development

# ── Filesystem ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jerp.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / S3 (opsional, prod) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── App portal Legal & Sales (Next.js, path /legal & /sales di jerp-nginx) ──
# Secret SSO dibagi jerp + kedua container (WAJIB sama). DB-nya PostgreSQL (service `postgres`).
PORTAL_SSO_SECRET=
PG_USER=jerp
PG_PASSWORD=pgsecret
LEGAL_AUTH_SECRET=
# Secret callback approval eksternal Legal (GM→Direktur→Owner). WAJIB diisi:
# endpoint fail-closed — tanpa ini semua request /api/external-approval ditolak.
LEGAL_EXTERNAL_APPROVAL_SECRET=
SALES_NEXTAUTH_SECRET=
# URL yang dijangkau BROWSER (produksi: https://<domain>/sales/api/auth & /legal|/sales)
SALES_NEXTAUTH_URL=
PORTAL_LEGAL_URL=
PORTAL_SALES_URL=

# ── 3rd-party integrations (Phase 3+) ───────────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Backup — root folder default disk lokal "backup_target" (bisa diubah di UI Pengaturan Backup)
BACKUP_TARGET_ROOT=

# Mekari Qontak — WhatsApp notification (UTJ payment & NUP confirmation)
QONTAK_ACCESS_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
QONTAK_BASE_URL=https://service-chat.qontak.com/api/open/v1
QONTAK_LANGUAGE=id
QONTAK_TEMPLATE_UTJ=
QONTAK_TEMPLATE_NUP_APPROVAL=

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
VITE_RECAPTCHA_SITE_KEY="${RECAPTCHA_SITE_KEY}"

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=

# ── Backup ──────────────────────────────────────────────────────────
BACKUP_DESTINATION_DISKS=local
BACKUP_NOTIFICATION_EMAIL=
BACKUP_RETENTION_DAYS=365

# ── Error tracking (opsional) ───────────────────────────────────────
SENTRY_LARAVEL_DSN=

# ── Vite ────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
