# J-ERP — .dockerignore (template untuk repo Laravel target)
# Tujuan: image kecil + tidak membocorkan secret / artefak dev.

# Git
.git
.gitignore
.gitattributes

# Editor / IDE
.idea
.vscode
*.swp
*.swo
.DS_Store
Thumbs.db

# Env & secrets
.env
.env.*
!.env.example

# Logs
storage/logs/*
!storage/logs/.gitkeep

# Framework cache (akan di-rebuild di stage runtime)
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# Laravel runtime artefacts
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/app/backups/*
!storage/app/backups/.gitignore
storage/app/public/*
!storage/app/public/.gitignore

# Composer / Node — di-install ulang di build stage
vendor/
node_modules/
public/build/
public/hot
# Symlink storage:link (absolute target) — BuildKit tak bisa COPY; dibuat ulang saat runtime
public/storage

# Test artefacts
.phpunit.cache/
.phpunit.result.cache
coverage/
phpunit.xml.bak

# Docker compose / orchestration files (Dockerfile + docker/ stay — they're COPY'd during build)
docker-compose*.yml
docker-compose.override.yml.example

# CI / tooling
.github/
.gitlab-ci.yml
.dockerignore

# Documentation snapshot (legacy reference, bukan source code)
PRD.md
PRD_cloning.md
ERD.md
ERD_cloning.md
CLAUDE.md
claude_cloning.md
README.md.bak
*.bak
*.bak.gz

# OS junk
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / dist
dist/
build/
tmp/
temp/
