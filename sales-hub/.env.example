# ---- Copy these into your host's Environment Variables (e.g. Vercel) ----

# PostgreSQL connection string from your managed DB (Neon / Vercel Postgres / Supabase).
# Include ?sslmode=require for hosted providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# The public URL your app is served at (Vercel gives you one, e.g. https://xxx.vercel.app).
# For a custom domain, use that instead. MUST match the address users open.
NEXTAUTH_URL="https://your-app.vercel.app"

# Strong random secret. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ---- AI appeal analysis (Pipeline Gagal → slot "Analisa AI") ----
# Anthropic API key. Locally, DON'T paste it here — run `./hub.sh setkey`
# (hidden input, writes to .env which is gitignored). On a host, set it as an
# env var. Get one at https://console.anthropic.com (billed per use).
ANTHROPIC_API_KEY="sk-ant-..."
# Optional — cheaper/faster model (default: claude-opus-4-8)
# ANTHROPIC_MODEL="claude-haiku-4-5"

# ---- Tier-2 demographic pathway (POST /api/demographic/sync) ----
# Bearer token the external CRM/survey system sends to push demographic data.
# Leave unset to keep the endpoint disabled (returns 501). Generate with:
# openssl rand -hex 24
# DEMOGRAPHIC_SYNC_TOKEN="replace-with-a-long-random-token"
