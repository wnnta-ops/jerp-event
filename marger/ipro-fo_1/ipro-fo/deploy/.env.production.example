# Java Core System — .env PRODUKSI (Oracle Cloud + Caddy + PHP 8.4 FPM)
# Salin ke ../.env lalu isi APP_KEY (dari .env lokalmu) & APP_URL (domainmu).

APP_NAME="Java Core System"
APP_ENV=production
APP_KEY=                       # WAJIB: salin APP_KEY dari .env lokal (jangan generate baru bila DB sudah ada data)
APP_DEBUG=false
APP_URL=https://javacore-mup.duckdns.org   # GANTI dengan domain/subdomainmu
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database — SQLite (path ABSOLUT di server)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/javacore/database/database.sqlite

# Single VM → driver lokal (tanpa Redis)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Email — default 'log'. Isi SMTP bila perlu kirim email beneran.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@javacore.local"
MAIL_FROM_NAME="${APP_NAME}"

# spatie/browsershot (PDF) — set bila Chromium tak terdeteksi otomatis
# BROWSERSHOT_CHROME_PATH=/usr/bin/chromium-browser
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
