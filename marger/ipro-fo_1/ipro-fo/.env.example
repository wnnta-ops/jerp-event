# ──────────────────────────────────────────────────────────────────────────────
# Java Core System v2.0 — Environment Variables
# Copy file ini ke .env lalu sesuaikan untuk environment Anda.
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME="Java Core System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipro_fo
DB_USERNAME=root
DB_PASSWORD=

# ── Cache, Session, Queue ─────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
HORIZON_PREFIX=ipro-fo:

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=ipro-fo
# AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=http://minio:9000

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ipro-fo.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting (Reverb) ─────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=ipro-fo
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SESSION_SAME_SITE=lax

# ── Octane ────────────────────────────────────────────────────────────────────
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# ── Domain Configuration ──────────────────────────────────────────────────────
DOMAIN_DEFAULT_PPN_PCT=11
DOMAIN_DEFAULT_DENDA_RATE_PER_DAY=0.0005
DOMAIN_DEFAULT_HOLD_DAYS=7
DOMAIN_DEFAULT_NUP_REFUND_PENALTY_PCT=10
DOMAIN_DEFAULT_CURRENCY=IDR
DOMAIN_TIMEZONE=Asia/Jakarta

# ── Auth Policy ───────────────────────────────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_ROTATION_DAYS=90
AUTH_SESSION_IDLE_MINUTES=30
AUTH_MFA_REQUIRED_ROLES=SuperAdmin,Direktur,FinanceManager

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Webhook Integration ───────────────────────────────────────────────────────
WEBHOOK_BANK_VA_SECRET=
WEBHOOK_PRIVYID_SECRET=
WEBHOOK_WHATSAPP_TOKEN=

# ── External API ──────────────────────────────────────────────────────────────
WA_BUSINESS_API_URL=
WA_BUSINESS_API_TOKEN=
WA_BUSINESS_PHONE_ID=
