# ──────────────────────────────────────────────────────────────────────────────
# Java Core System v2.0 — BACK OFFICE (BO/Bankloan), menyatu dengan J-ERP (FO).
# DB & SSO berbagi dengan J-ERP. Copy ke .env lalu isi. Lihat marger/DEPLOY.md.
#
# SERVER (domain): APP_ENV=production  APP_DEBUG=false  APP_URL=https://bo.test.com
#   + WAJIB: DB_PASSWORD (= user `jerp` di jerp-mysql), SSO_SHARED_SECRET, FO_URL,
#     dan APP_KEY = IPRO_APP_KEY di .env J-ERP (lihat catatan masing-masing di bawah).
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME="Java Core System"
APP_ENV=local
# WAJIB = IPRO_APP_KEY pada .env J-ERP (kunci enkripsi PII bersama, termasuk "base64:").
# JANGAN `php artisan key:generate` setelah diisi — memutus dekripsi NIK/NPWP dari FO.
APP_KEY=
APP_DEBUG=true
# Domain BO. Server: https://bo.test.com  ·  Lokal: http://localhost:8090
APP_URL=http://localhost:8090
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MENYATU dgn J-ERP: jerp-mysql, database ipro_bo) ─────────────────
# Lewat 3-file compose, docker-compose.shared.yml meng-override DB_HOST/DATABASE/
# USERNAME ke jerp-mysql/ipro_bo/jerp. DB_PASSWORD di bawah DIPAKAI compose untuk
# user `jerp` → WAJIB sama dengan DB_PASSWORD (user jerp) di .env J-ERP.
DB_CONNECTION=mysql
DB_HOST=jerp-mysql
DB_PORT=3306
DB_DATABASE=ipro_bo
DB_USERNAME=jerp
DB_PASSWORD=secret

# ═══════════════════════════════════════════════════════════════════
# INTEGRASI FO (J-ERP) — SSO & link balik. WAJIB selaras dengan .env J-ERP.
# ═══════════════════════════════════════════════════════════════════
# Kunci tanda tangan SSO (HMAC) — WAJIB SAMA PERSIS dgn SSO_SHARED_SECRET di .env J-ERP.
SSO_SHARED_SECRET=
# URL FO (J-ERP) — login utama, link "Kembali", & base API mobile (<FO_URL>/api/mobile).
# Server: https://fo.test.com  ·  Lokal: http://localhost:8081
FO_URL=http://localhost:8081
# Akses BO/Bankloan HANYA via login J-ERP (1 pintu). true (default) = /login BO
# dialihkan ke FO_URL/login; masuk BO hanya lewat SSO dari hub J-ERP.
# Set false HANYA untuk pemulihan darurat (mengizinkan login langsung BO).
SSO_FO_LOGIN_ONLY=true

# ── Cache, Session, Queue ─────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
HORIZON_PREFIX=ipro-fo:

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=ipro-fo
# AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=http://minio:9000

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ipro-fo.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting (Reverb) ─────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=ipro-fo
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# ── Sanctum ───────────────────────────────────────────────────────────────────
# Server: tambahkan domain BO, mis. bo.test.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8090,127.0.0.1
SESSION_SAME_SITE=lax

# ── Octane ────────────────────────────────────────────────────────────────────
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# ── Domain Configuration ──────────────────────────────────────────────────────
DOMAIN_DEFAULT_PPN_PCT=11
DOMAIN_DEFAULT_DENDA_RATE_PER_DAY=0.0005
DOMAIN_DEFAULT_HOLD_DAYS=7
DOMAIN_DEFAULT_NUP_REFUND_PENALTY_PCT=10
DOMAIN_DEFAULT_CURRENCY=IDR
DOMAIN_TIMEZONE=Asia/Jakarta

# ── Auth Policy ───────────────────────────────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_ROTATION_DAYS=90
AUTH_SESSION_IDLE_MINUTES=30
AUTH_MFA_REQUIRED_ROLES=SuperAdmin,Direktur,FinanceManager

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Webhook Integration ───────────────────────────────────────────────────────
WEBHOOK_BANK_VA_SECRET=
WEBHOOK_PRIVYID_SECRET=
WEBHOOK_WHATSAPP_TOKEN=

# ── External API ──────────────────────────────────────────────────────────────
WA_BUSINESS_API_URL=
WA_BUSINESS_API_TOKEN=
WA_BUSINESS_PHONE_ID=

# ── MUK ERP — API kontrak & progres konstruksi (baca-saja) ───────────────────
# Sumber angka SPK. Kunci dikirim tim MUK lewat kanal terpisah; JANGAN ditulis di
# sini atau di mana pun yang masuk git — hanya di .env server.
MUK_API_URL=https://app.mukjavacoresystem.com/api/mup
MUK_API_KEY=
MUK_API_AKTIF=true
MUK_API_TIMEOUT=20
