# ============================================================
#  Java Core System — TEMPLATE .env PRODUKSI
#  Salin ke .env di server, lalu isi nilai yang ditandai <ISI>.
#  JANGAN commit file .env asli ke git.
# ============================================================

APP_NAME="Java Core System"
APP_ENV=production
APP_KEY=                      # generate di server: php artisan key:generate
APP_DEBUG=false               # WAJIB false di produksi
APP_URL=https://<ISI-DOMAIN>  # mis. https://javacore-mup.duckdns.org

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# ---- Log (lebih hemat di produksi) ----
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- Database: SQLite (default, paling simpel) ----
DB_CONNECTION=sqlite
# DB_DATABASE otomatis -> database/database.sqlite (biarkan kosong)
DB_FOREIGN_KEYS=true
# Optimasi multi-user (mengurangi "database is locked"):
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

# >>> Jika nanti pindah ke MySQL/MariaDB, ganti blok di atas dengan:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=javacore
# DB_USERNAME=javacore
# DB_PASSWORD=<ISI>

# ---- Session / Cache / Queue (driver database = aman lintas proses) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # cookie hanya via HTTPS
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Email (opsional; isi bila ingin kirim notifikasi/reset password) ----
MAIL_MAILER=log                # ganti ke smtp + kredensial bila perlu kirim email
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@javacore.local"
# MAIL_FROM_NAME="${APP_NAME}"

# ---- PDF (Browsershot) — set bila Chromium dipasang manual ----
# BROWSERSHOT_CHROME_PATH=/usr/bin/chromium-browser
