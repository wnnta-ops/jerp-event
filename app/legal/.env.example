# Copy to .env (local) or set as Vercel Environment Variables (production).

# Database. Local dev = SQLite; production = Postgres (Neon/Vercel Postgres).
# Local:  DATABASE_URL="file:./dev.db"
# Prod:   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# Session signing secret (REQUIRED). Generate: openssl rand -hex 32
AUTH_SECRET="change-me-openssl-rand-hex-32"

# Where uploaded request documents are written. On Vercel set to /tmp/request-docs
# (serverless disk is read-only except /tmp). Leave unset for local dev.
# REQUEST_DOCS_DIR="/tmp/request-docs"

# Optional: published Google Sheet (read-only "Lembar Data" tab).
# GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/.../pub?output=csv"
# GOOGLE_SHEET_TITLE="Lembar Data"

# Optional: path to LibreOffice "soffice" for pixel-faithful docx→PDF in the
# "Draft Dokumen" tab. Auto-detected on macOS/Linux; set only if installed
# elsewhere. Without LibreOffice the PDF falls back to a simple text layout.
# SOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"

# Optional: external approval app (GM → Direktur → Owner) for physical-original
# checkout. After Head of Legal signs in THIS app, the request is forwarded to
# this webhook; that app calls back POST /api/external-approval to finalize.
# Leave unset to keep physical requests resting in "pending_external".
# EXTERNAL_APPROVAL_WEBHOOK_URL="https://approval.example.com/intake"
# EXTERNAL_APPROVAL_SECRET="shared-secret-for-x-approval-secret-header"
