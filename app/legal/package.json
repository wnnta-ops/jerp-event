    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "next": "^14.2.5",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
