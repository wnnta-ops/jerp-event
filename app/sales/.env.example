# ---- Copy these into your host's Environment Variables (e.g. Vercel) ----

# PostgreSQL connection string from your managed DB (Neon / Vercel Postgres / Supabase).
# Include ?sslmode=require for hosted providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# The public URL your app is served at (Vercel gives you one, e.g. https://xxx.vercel.app).
# For a custom domain, use that instead. MUST match the address users open.
NEXTAUTH_URL="https://your-app.vercel.app"

# Strong random secret. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
